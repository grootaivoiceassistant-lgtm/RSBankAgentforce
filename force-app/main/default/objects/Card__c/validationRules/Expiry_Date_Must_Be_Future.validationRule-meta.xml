<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Expiry_Date_Must_Be_Future</fullName>
    <active>true</active>
    <errorConditionFormula>Expiry_Date__c &lt;= TODAY()</errorConditionFormula>
    <errorMessage>Expiry date must be in the future</errorMessage>
</ValidationRule>
