<aura:component implements="force:lightningQuickActionWithoutHeader,force:hasRecordId" access="global">
    <aura:attribute name="message" type="String" default="Hello from ToastFromVF"/>
    <lightning:input type="text" label="Message" value="{!v.message}" />
    <lightning:button label="Send Toast" onclick="{!c.showToast}"/>
</aura:component>